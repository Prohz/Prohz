                                </p>

                            </div>


                            <div class="price-block">

                                <span class="promo-price">
                                    $575.00
                                </span>

                                <span class="disclaimer">
                                    per year
                                </span>

                            </div>


                            <div class="card-meta">

                                <ul>

                                    <li>
                                        20 Categories
                                    </li>

                                    <li>
                                        100 Service Areas
                                    </li>

                                    <li>
                                        Business Profile
                                    </li>

                                    <li>
                                        Unlimited Searches
                                    </li>

                                    <li>
                                        Downgrade anytime
                                    </li>

                                </ul>

                            </div>


                            @if (CurrentPlanId == PlanIdMaximize)
                            {

                                <button type="button"
                                        disabled
                                        style="opacity:0.65; cursor:not-allowed;">

                                    @BuyNowMaximize

                                </button>

                            }
                            else
                            {

                                <button type="button"
                                        onclick="SwitchToMaximizeSubscription()">

                                    @BuyNowMaximize

                                </button>

                            }

                        </div>

                    </div>

                </div>


            </div>

        </div>

    </section>

</div>


