@model KopkeHome_ModelLayer.ViewModels.DashboardViewModels.MembershipBenifitsAndSubcriptionPlan.MembershipAndSubscriptionPlanViewModel

@{
    Layout = "~/Views/Shared/_DashboardInternal.cshtml";
}

@inject IViewLocalizer Localizer

@{
    #pragma warning disable

    // ============================================================
    // NEW MEMBERSHIP PLANS
    // Connect -> Expand -> Maximize
    // ============================================================

    var connect = Model.Plans.FirstOrDefault(x =>
        x.Title.Equals("Connect", StringComparison.OrdinalIgnoreCase));

    var expand = Model.Plans.FirstOrDefault(x =>
        x.Title.Equals("Expand", StringComparison.OrdinalIgnoreCase));

    var maximize = Model.Plans.FirstOrDefault(x =>
        x.Title.Equals("Maximize", StringComparison.OrdinalIgnoreCase));


    // Plan IDs
    int PlanIdConnect = connect?.Id ?? 0;
    int PlanIdExpand = expand?.Id ?? 0;
    int PlanIdMaximize = maximize?.Id ?? 0;


    // ============================================================
    // NEW STRIPE PRICE IDs
    // These are the same Price IDs currently being used on signup.
    // ============================================================

    string PriceIdConnect = "price_1TxuVxILheuScUW2Vuo31tzs";
    string PriceIdExpand = "price_1TywvTILheuScUW2PUyV5Z6y";
    string PriceIdMaximize = "price_1TywwEILheuScUW2rOugmfuW";


    // ============================================================
    // CURRENT SUBSCRIPTION
    // ============================================================

    int CurrentPlanId = Model.SubscriptionsStripeData?.PlanId ?? 0;

    string CurrentStripePriceId =
        Model.SubscriptionsStripeData?.StripePriceId ?? string.Empty;


    // ============================================================
    // CURRENT PLAN NAME
    // ============================================================

    string CurrentPlanName = "No Plan";

    if (CurrentPlanId == PlanIdConnect)
    {
        CurrentPlanName = "Connect";
    }
    else if (CurrentPlanId == PlanIdExpand)
    {
        CurrentPlanName = "Expand";
    }
    else if (CurrentPlanId == PlanIdMaximize)
    {
        CurrentPlanName = "Maximize";
    }


    // ============================================================
    // BUTTON TEXT
    // ============================================================

    string BuyNowConnect = Localizer["Join Now"].Value;
    string BuyNowExpand = Localizer["Join Now"].Value;
    string BuyNowMaximize = Localizer["Join Now"].Value;


    if (CurrentPlanId == PlanIdConnect)
    {
        BuyNowConnect = Localizer["Current Plan"].Value;
        BuyNowExpand = Localizer["Upgrade Now"].Value;
        BuyNowMaximize = Localizer["Upgrade Now"].Value;
    }
    else if (CurrentPlanId == PlanIdExpand)
    {
        BuyNowConnect = Localizer["Downgrade Now"].Value;
        BuyNowExpand = Localizer["Current Plan"].Value;
        BuyNowMaximize = Localizer["Upgrade Now"].Value;
    }
    else if (CurrentPlanId == PlanIdMaximize)
    {
        BuyNowConnect = Localizer["Downgrade Now"].Value;
        BuyNowExpand = Localizer["Downgrade Now"].Value;
        BuyNowMaximize = Localizer["Current Plan"].Value;
    }


    // ============================================================
    // PLAN ACTIVE CLASSES
    // ============================================================

    string IsActiveConnect = CurrentPlanId == PlanIdConnect ? "active" : "";
    string IsActiveExpand = CurrentPlanId == PlanIdExpand ? "active" : "";
    string IsActiveMaximize = CurrentPlanId == PlanIdMaximize ? "active" : "";


    // ============================================================
    // MEMBER TYPE
    // ============================================================

    string membertype = string.Empty;

    if (Model.LoggedInUser.RoleId == 2)
    {
        membertype = Localizer["Sub Contractor"].Value;
    }
    else if (Model.LoggedInUser.RoleId == 3)
    {
        membertype = Localizer["Independent Contractor"].Value;
    }
    else
    {
        membertype = Localizer["Contractor"].Value;
    }

}

<head>

    <!-- Font CSS -->
    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:ital,wght@0,400;0,700;1,400;1,700&display=swap"
          rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
          integrity="sha512-DTOQO9RWCH3ppGqcWAa1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
          crossorigin="anonymous"
          referrerpolicy="no-referrer" />

    <!-- Custom CSS -->
    <link href="~/HomePageAssets/assets/css/style.css"
          rel="stylesheet">

    <link rel="stylesheet"
          href="~/css/master.css"
          asp-append-version="true" />

</head>


<script>

    // ============================================================
    // URL PREFIX
    // ============================================================

    var urlprefix = '';

    if (window.location.href.indexOf("KopkeHome-FMRS-QA") > -1) {
        urlprefix = '/KopkeHome-FMRS-QA';
    }
    else if (window.location.href.indexOf("KopkeHome-FMRS") > -1) {
        urlprefix = '/KopkeHome-FMRS';
    }


    // ============================================================
    // PROHZ LOGO
    // ============================================================

    var ProhzGreyLogo =
        '<img style="height: 90px;" src="' +
        urlprefix +
        '/images/ProhzGreyLogo.new.png">';


    // ============================================================
    // CANCEL SUBSCRIPTION - AFTER CANCEL
    // ============================================================

    function AfterCancelSubscription(s) {

        Swal.fire({
            icon: 'error',

            title: localizer(
                'Current Plan is Cancelled.',
                'El plan actual está cancelado',
                $('#ProhzLangDDL option:selected').val()
            ),

            text: localizer(
                'You have cancelled current plan.You can still use the application as long as your last plan is valid.',
                'Ha cancelado el plan actual. Todavía puede usar la aplicación siempre que su último plan sea válido.',
                $('#ProhzLangDDL option:selected').val()
            )
        });
    }


    // ============================================================
    // CANCEL SUBSCRIPTION
    // ============================================================

    function CancelSubscription(element) {

        var id = element.getAttribute("id");

        var EndDate = element.getAttribute("data-EndDate");

        Swal.fire({

            title: localizer(
                'Are You Sure?',
                'Estas seguro?',
                $('#ProhzLangDDL option:selected').val()
            ),

            iconHtml: ProhzGreyLogo,

            text: localizer(
                'Current Plan will be cancelled but you can still use the benefits and services till the end of the current billing cycle i.e ' +
                EndDate +
                ', Do you want to cancel it ?',

                'El plan actual se cancelará, pero aún puede usar los beneficios y servicios hasta el final del ciclo de facturación actual, es decir,' +
                EndDate +
                ', ¿Quieres cancelarla?',

                $('#ProhzLangDDL option:selected').val()
            ),

            showDenyButton: true,

            showCancelButton: false,

            confirmButtonText: localizer(
                'Do not cancel',
                'No cancelar',
                $('#ProhzLangDDL option:selected').val()
            ),

            denyButtonText: localizer(
                'Yes, cancel it.',
                'Sí, cancelarlo.',
                $('#ProhzLangDDL option:selected').val()
            )

        }).then((result) => {

            if (result.isDenied) {

                $.ajax({

                    type: 'GET',

                    url:
                        urlprefix +
                        '/Payment/CancelSubscription?subId=' +
                        id,

                    success: function (res) {

                        if (res == "1") {

                            Swal.fire(
                                localizer(
                                    'Subscription Cancelled!',
                                    '¡Suscripción cancelada!',
                                    $('#ProhzLangDDL option:selected').val()
                                ),
                                '',
                                'success'
                            );

                            location.reload();

                        }
                        else {

                            Swal.fire(
                                localizer(
                                    'Network Issue!',
                                    '¡Problema de red!',
                                    $('#ProhzLangDDL option:selected').val()
                                ),
                                '',
                                'info'
                            );
                        }

                    },

                    error: function () {

                        Swal.fire(
                            localizer(
                                'Network Issue!',
                                '¡Problema de red!',
                                $('#ProhzLangDDL option:selected').val()
                            ),
                            '',
                            'error'
                        );

                    }

                });

            }

        });
    }


    // ============================================================
    // GENERAL PLAN SWITCH FUNCTION
    // ============================================================

    function SwitchSubscription(
        targetPlanId,
        targetPriceId,
        targetPlanName,
        targetRank
    ) {

        var currentPlanId = @CurrentPlanId;

        var currentPlanName = "@CurrentPlanName";

        var subId = "@(Model.SubscriptionsStripeData?.StripeSubscriptionId ?? "")";

        var customerId = "@(Model.SubscriptionsStripeData?.StripeCustomerID ?? "")";

        var lastDate = "@(Model.SubscriptionsStripeData?.PeriodEndDate ?? "")";


        // --------------------------------------------------------
        // Current plan check
        // --------------------------------------------------------

        if (currentPlanId == targetPlanId) {

            Swal.fire({

                title: localizer(
                    'Already Subscribed',
                    'Ya está suscrito',
                    $('#ProhzLangDDL option:selected').val()
                ),

                iconHtml: ProhzGreyLogo,

                text: localizer(
                    'You are already subscribed to the ' +
                    targetPlanName +
                    ' plan.',
                    'Ya está suscrito al plan ' +
                    targetPlanName +
                    '.',
                    $('#ProhzLangDDL option:selected').val()
                )

            });

            return;
        }


        // --------------------------------------------------------
        // Determine upgrade/downgrade
        // --------------------------------------------------------

        var action = "";

        var actionSpanish = "";

        var message = "";

        var messageSpanish = "";


        if (targetRank > getCurrentPlanRank()) {

            action = "Upgrade";

            actionSpanish = "Potenciar";

            message =
                "Your subscription will be upgraded from " +
                currentPlanName +
                " to " +
                targetPlanName +
                ".";

            messageSpanish =
                "Su suscripción se actualizará de " +
                currentPlanName +
                " a " +
                targetPlanName +
                ".";

        }
        else {

            action = "Downgrade";

            actionSpanish = "Degradar";

            message =
                "Your subscription will be changed from " +
                currentPlanName +
                " to " +
                targetPlanName +
                ".";

            messageSpanish =
                "Su suscripción cambiará de " +
                currentPlanName +
                " a " +
                targetPlanName +
                ".";

        }


        // --------------------------------------------------------
        // Confirmation
        // --------------------------------------------------------

        Swal.fire({

            title: localizer(
                'Are You Sure?',
                '¿Está seguro?',
                $('#ProhzLangDDL option:selected').val()
            ),

            iconHtml: ProhzGreyLogo,

            text: localizer(
                message +
                " Do you wish to continue?",

                messageSpanish +
                " ¿Desea continuar?",

                $('#ProhzLangDDL option:selected').val()
            ),

            showDenyButton: true,

            showCancelButton: false,

            confirmButtonText: localizer(
                'Do not ' + action,
                'No ' + actionSpanish,
                $('#ProhzLangDDL option:selected').val()
            ),

            denyButtonText: localizer(
                'Yes, ' + action + ' it.',
                'Sí, ' + actionSpanish + ' eso.',
                $('#ProhzLangDDL option:selected').val()
            )

        }).then((result) => {

            if (!result.isDenied) {
                return;
            }


            // ----------------------------------------------------
            // Show loader
            // ----------------------------------------------------

            $("#CSTMLOADER").show();


            // ----------------------------------------------------
            // Upgrade
            // ----------------------------------------------------

            if (targetRank > getCurrentPlanRank()) {

                $.ajax({

                    type: 'GET',

                    url:
                        urlprefix +
                        '/Payment/UpgradeSubscription' +
                        '?subId=' +
                        encodeURIComponent(subId) +
                        '&CusId=' +
                        encodeURIComponent(customerId) +
                        '&PriceId=' +
                        encodeURIComponent(targetPriceId) +
                        '&PlanId=' +
                        encodeURIComponent(targetPlanId),

                    success: function (res) {

                        console.log(
                            "Upgrade Subscription Response:",
                            res
                        );


                        if (res && res != "1") {

                            window.location = res;

                        }
                        else {

                            $("#CSTMLOADER").hide();

                            Swal.fire(
                                localizer(
                                    'Subscription Upgraded!',
                                    '¡Suscripción actualizada!',
                                    $('#ProhzLangDDL option:selected').val()
                                ),
                                '',
                                'success'
                            );

                            setTimeout(function () {

                                location.reload(true);

                            }, 1500);

                        }

                    },

                    error: function (xhr) {

                        $("#CSTMLOADER").hide();

                        console.log(
                            "Upgrade error:",
                            xhr.responseText
                        );

                        Swal.fire(
                            localizer(
                                'Something went wrong!',
                                '¡Algo salió mal!',
                                $('#ProhzLangDDL option:selected').val()
                            ),
                            '',
                            'error'
                        );

                    }

                });

            }

            // ----------------------------------------------------
            // Downgrade
            // ----------------------------------------------------

            else {

                $.ajax({

                    type: 'GET',

                    url:
                        urlprefix +
                        '/Payment/DowngradeSubscription' +
                        '?subId=' +
                        encodeURIComponent(subId) +
                        '&CusId=' +
                        encodeURIComponent(customerId) +
                        '&PriceId=' +
                        encodeURIComponent(targetPriceId) +
                        '&PlanId=' +
                        encodeURIComponent(targetPlanId),

                    success: function (res) {

                        console.log(
                            "Downgrade Subscription Response:",
                            res
                        );


                        if (res && res != "1") {

                            window.location = res;

                        }
                        else {

                            $("#CSTMLOADER").hide();

                            Swal.fire(
                                localizer(
                                    'Subscription Changed!',
                                    '¡Suscripción actualizada!',
                                    $('#ProhzLangDDL option:selected').val()
                                ),
                                '',
                                'success'
                            );

                            setTimeout(function () {

                                location.reload(true);

                            }, 1500);

                        }

                    },

                    error: function (xhr) {

                        $("#CSTMLOADER").hide();

                        console.log(
                            "Downgrade error:",
                            xhr.responseText
                        );

                        Swal.fire(
                            localizer(
                                'Something went wrong!',
                                '¡Algo salió mal!',
                                $('#ProhzLangDDL option:selected').val()
                            ),
                            '',
                            'error'
                        );

                    }

                });

            }

        });
    }


    // ============================================================
    // CURRENT PLAN RANK
    //
    // Connect  = 1
    // Expand   = 2
    // Maximize = 3
    // ============================================================

    function getCurrentPlanRank() {

        var currentPlanId = @CurrentPlanId;

        var connectId = @PlanIdConnect;

        var expandId = @PlanIdExpand;

        var maximizeId = @PlanIdMaximize;


        if (currentPlanId == connectId) {
            return 1;
        }

        if (currentPlanId == expandId) {
            return 2;
        }

        if (currentPlanId == maximizeId) {
            return 3;
        }

        return 0;
    }


    // ============================================================
    // CONNECT
    // ============================================================

    function SwitchToConnectSubscription() {

        SwitchSubscription(
            @PlanIdConnect,
            "@PriceIdConnect",
            "Connect",
            1
        );

    }


    // ============================================================
    // EXPAND
    // ============================================================

    function SwitchToExpandSubscription() {

        SwitchSubscription(
            @PlanIdExpand,
            "@PriceIdExpand",
            "Expand",
            2
        );

    }


    // ============================================================
    // MAXIMIZE
    // ============================================================

    function SwitchToMaximizeSubscription() {

        SwitchSubscription(
            @PlanIdMaximize,
            "@PriceIdMaximize",
            "Maximize",
            3
        );

    }

</script>


<!-- ============================================================
     LOADER
============================================================ -->

<div class="logo-loader"
     id="CSTMLOADER"
     style="display:none">

    <div class="logo-loader-pulse pulse"
         id="Idloader">

        <img src="~/images/Kopke-brand-logo.png" />

    </div>

</div>


<!-- ============================================================
     MAIN DASHBOARD
============================================================ -->

<div class="dashboard-main-container">


    <!-- ========================================================
         HEADER
    ========================================================= -->

    <div class="dashboard-top-heading dashboard-top-heading-cstm">

        <h3 class="green-clr mb-5">

            @Localizer["Membership Benefits Plan For"]
            @membertype

        </h3>


        <div class="d-flex align-items-center">

            <p class="text-white m-0">

                <a href="@Url.Action("index", "dashboard")"
                   class="text-white">

                    <i class="fa fa-long-arrow-left forgot-back-arrow"
                       aria-hidden="true"></i>

                    @Localizer["Go back"]

                </a>

            </p>

        </div>

    </div>


    <!-- ========================================================
         SUBSCRIPTION STATUS
    ========================================================= -->

    <div class="text-right">

        @if (Model.SubscriptionsStripeData != null &&
             !string.IsNullOrEmpty(Model.SubscriptionsStripeData.StripeStatus) &&
             Model.SubscriptionsStripeData.StripeStatus.Contains("Cancelled"))
        {

            <p class="text-warning">

                @Localizer["Your current plan is cancelled but you can use the application until"]

                @Model.SubscriptionsStripeData.PeriodEndDate

            </p>

        }
        else
        {

            <p class="text-success">

                @Localizer["Subscription expires on"]

                @Model.SubscriptionsStripeData?.PeriodEndDate

                @Localizer["(AutoRenewable)"]

            </p>


            @if (Model.SubscriptionsStripeData != null &&
                 !string.IsNullOrEmpty(Model.SubscriptionsStripeData.StripeSubscriptionId))
            {

                <button id="@Model.SubscriptionsStripeData.StripeSubscriptionId"
                        data-EndDate="@Model.SubscriptionsStripeData.PeriodEndDate"
                        onclick="CancelSubscription(this);"
                        type="button"
                        class="button btn red-modal-btn">

                    @Localizer["Cancel Subscription"]

                    <i class="fa-light fa-xmark"></i>

                </button>

            }

        }

    </div>


    <!-- ========================================================
         PRICING
    ========================================================= -->

    <section id="pricing"
             style="background: linear-gradient(180deg, #2f2f2f 50%, transparent 50%);">

        <div class="container">


            <!-- ==================================================
                 TITLE
            ================================================== -->

            <div class="row"
                 style="text-align: center; color: #ffffff;">

                <div class="col">

                    <div class="title-wrapper">

                        <h2>
                            Contractor Membership Plans
                        </h2>

                        <p>
                            Please choose the best membership plan for you.
                        </p>

                        <p class="disclaimer">
                            All plans are based on one year memberships.
                        </p>

                    </div>

                </div>

            </div>


            <!-- ==================================================
                 PLAN CARDS
            ================================================== -->

            <div class="row">


                <!-- ==================================================
                     CONNECT
                ================================================== -->

                <div class="col">

                    <div class="card-wrapper @IsActiveConnect">

                        <div class="title-wrapper">


                            <div class="plan-header">

                                <h3>
                                    Prohz Connect
                                </h3>

                                <p>
                                    Get your business connected to the
                                    PROHZ network for free.
                                </p>

                            </div>


                            <span class="price-note">
                                No credit card required
                            </span>


                            <div class="price-block">

                                <span class="promo-price">
                                    $0.00
                                </span>

                                <span class="disclaimer">
                                    per year
                                </span>

                            </div>


                            <div class="card-meta">

                                <ul>

                                    <li>
                                        2 Categories
                                    </li>

                                    <li>
                                        10 Service Areas
                                    </li>

                                    <li>
                                        Business Profile
                                    </li>

                                    <li>
                                        Unlimited Searches
                                    </li>

                                    <li>
                                        Upgrade anytime for additional
                                        Categories and Service Areas
                                    </li>

                                </ul>

                            </div>


                            @if (CurrentPlanId == PlanIdConnect)
                            {

                                <button type="button"
                                        disabled
                                        style="opacity:0.65; cursor:not-allowed;">

                                    @BuyNowConnect

                                </button>

                            }
                            else
                            {

                                <button type="button"
                                        onclick="SwitchToConnectSubscription()">

                                    @BuyNowConnect

                                </button>

                            }

                        </div>

                    </div>

                </div>


                <!-- ==================================================
                     EXPAND
                ================================================== -->

                <div class="col">

                    <div class="card-wrapper best-value @IsActiveExpand">

                        <div class="title-wrapper">


                            <span class="best">
                                Best Value
                            </span>


                            <div class="plan-header">

                                <h3 style="display:inline-block;">
                                    Prohz Expand
                                </h3>

                                <p>
                                    Perfect for companies expanding into
                                    additional Categories and Service Areas.
                                </p>

                            </div>


                            <div class="price-block">

                                <span class="promo-price">
                                    $275.00
                                </span>

                                <span class="disclaimer">
                                    per year
                                </span>

                            </div>


                            <div class="card-meta">

                                <ul>

                                    <li>
                                        10 Categories
                                    </li>

                                    <li>
                                        30 Service Areas
                                    </li>

                                    <li>
                                        Business Profile
                                    </li>

                                    <li>
                                        Unlimited Searches
                                    </li>

                                    <li>
                                        Upgrade or downgrade anytime
                                    </li>

                                </ul>

                            </div>


                            @if (CurrentPlanId == PlanIdExpand)
                            {

                                <button type="button"
                                        disabled
                                        style="opacity:0.65; cursor:not-allowed;">

                                    @BuyNowExpand

                                </button>

                            }
                            else
                            {

                                <button type="button"
                                        onclick="SwitchToExpandSubscription()">

                                    @BuyNowExpand

                                </button>

                            }

                        </div>

                    </div>

                </div>


                <!-- ==================================================
                     MAXIMIZE
                ================================================== -->

                <div class="col">

                    <div class="card-wrapper @IsActiveMaximize">

                        <div class="title-wrapper">


                            <div class="plan-header">

                                <h3>
                                    Prohz Maximize
